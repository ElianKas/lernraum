{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study App Import v1",
  "type": "object",
  "required": ["version", "folder", "decks"],
  "properties": {
    "version": { "const": 1 },
    "folder": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "decks": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["title", "cards"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "cards": {
            "type": "array", "minItems": 1, "maxItems": 2000,
            "items": {
              "type": "object", "required": ["question", "answer"],
              "properties": {
                "question": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
                "answer": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S" }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Zusätzlich maximal 2000 Karten über alle Stapel und 5 MB Dateigröße; diese Regeln prüft die App."
}
