// Supabase Dashboard > Project Settings > API (URL) / API Keys (Publishable Key).
// The slash substitution prevents xcconfig from treating https:// as a comment.
SLASH = /
SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_OR_ANON_KEY
// Local overrides are ignored by Git; create Config.local.xcconfig next to this file.
#include? "Config.local.xcconfig"
